{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests; script-src 'self' 'unsafe-inline' https://translate.google.com https://translate.googleapis.com https://translate-pa.googleapis.com https://www.gstatic.com"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mr/articles",
      "destination": "/api/public-articles?language=mr"
    },
    {
      "source": "/mr/articles/:slug",
      "destination": "/api/public-articles?language=mr&slug=:slug"
    },
    {
      "source": "/hi/articles",
      "destination": "/api/public-articles?language=hi"
    },
    {
      "source": "/hi/articles/:slug",
      "destination": "/api/public-articles?language=hi&slug=:slug"
    },
    {
      "source": "/articles",
      "destination": "/api/public-articles"
    },
    {
      "source": "/articles/:slug",
      "destination": "/api/public-articles?slug=:slug"
    },
    {
      "source": "/article-sitemap.xml",
      "destination": "/api/article-sitemap"
    }
  ],
  "functions": {
    "api/evidence-workflow.js": {
      "maxDuration": 180
    },
    "api/evidence-webhook.js": {
      "maxDuration": 180
    }
  }
}
