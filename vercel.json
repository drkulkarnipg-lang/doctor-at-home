{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/doctor",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/doctor",
      "destination": "/index.html"
    },
    {
      "source": "/articles",
      "destination": "/api/public-articles"
    },
    {
      "source": "/articles/:slug",
      "destination": "/api/public-articles?slug=:slug"
    },
    {
      "source": "/article-sitemap.xml",
      "destination": "/api/article-sitemap"
    }
  ],
  "functions": {
    "api/evidence-workflow.js": {
      "maxDuration": 180
    },
    "api/evidence-webhook.js": {
      "maxDuration": 180
    }
  },
  "redirects": [
    {
      "source": "/doctor/",
      "destination": "/doctor",
      "permanent": false
    }
  ]
}
